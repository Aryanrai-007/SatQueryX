# Server-side AI credentials. Never expose these as NEXT_PUBLIC_* variables.
# Recommended current Gemini model: gemini-3.8-flash
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional fallback. OpenRouter's free router supports image input.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
