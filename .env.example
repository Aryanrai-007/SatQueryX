# SatQueryX external integrations
# No login/authentication variables exist by design.

# Google Gemini: synthesis only. It is NOT the remote-sensing adaptation checkpoint.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# SatQueryX remote-sensing VLM adapter produced by training/train_rs_vlm.py.
# REMOTE_VLM_MODEL_ID may be a local PEFT adapter directory or a Hugging Face adapter repo.
REMOTE_VLM_MODEL_ID=
REMOTE_VLM_IS_PEFT=1
RS_VLM_BASE_MODEL_ID=google/paligemma2-3b-pt-224
HF_TOKEN=
REMOTE_VLM_MAX_NEW_TOKENS=256

# Dedicated specialist checkpoints.
RS_GROUNDING_MODEL_ID=
RS_CHANGE_VQA_MODEL_ID=
RS_MULTIMODAL_MODEL_ID=

# Auxiliary detector only; it is NOT the SIH grounding model.
YOLO_MODEL_PATH=yolo11n.pt
YOLO_CONFIDENCE=0.25

# BigEarthNet.txt training assets (do not commit these files).
BIGEARTHNET_IMAGE_LMDB=
BIGEARTHNET_METADATA=
BIGEARTHNET_LOADER=

# Public benchmark roots, when downloaded locally.
VRSBENCH_ROOT=
RSVQA_ROOT=
CDVQA_ROOT=

# Processing limits
MAX_UPLOAD_MB=100
TILE_SIZE=512
TILE_OVERLAP=32
