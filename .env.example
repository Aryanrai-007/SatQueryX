# SatQueryX external integrations
# No login/authentication variables exist by design.

# Google Gemini: synthesis only. It is NOT the remote-sensing adaptation checkpoint.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Domain-adapted remote-sensing VLM produced by training/train_rs_vlm.py.
# Do not point this at the generic base model for the SIH submission.
REMOTE_VLM_MODEL_ID=
HF_TOKEN=
REMOTE_VLM_MAX_NEW_TOKENS=256

# Text-guided remote-sensing grounding checkpoint trained on grounding annotations.
RS_GROUNDING_MODEL_ID=

# Optional native dual-image optical/SAR checkpoint. The app has a labelled-pair
# adapter when this is not set, but native dual-encoder weights are preferred.
RS_MULTIMODAL_MODEL_ID=

# Auxiliary detector only; it is NOT the SIH grounding model.
YOLO_MODEL_PATH=yolo11n.pt
YOLO_CONFIDENCE=0.25

# BigEarthNet.txt training assets (do not commit these files).
BIGEARTHNET_IMAGE_LMDB=
BIGEARTHNET_METADATA=
BIGEARTHNET_LOADER=

# Public benchmark roots, when downloaded locally.
VRSBENCH_ROOT=
RSVQA_ROOT=
CDVQA_ROOT=

# Processing limits
MAX_UPLOAD_MB=100
TILE_SIZE=512
TILE_OVERLAP=32
