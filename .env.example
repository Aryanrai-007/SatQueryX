# SatQueryX external integrations
# No login/authentication variables exist by design.

# Google Gemini: required only for LLM evidence synthesis.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Hugging Face remote-sensing VLM. Set this to the exact checkpoint you provide.
REMOTE_VLM_MODEL_ID=
HF_TOKEN=
REMOTE_VLM_MAX_NEW_TOKENS=128

# Visual grounding. Use a real Ultralytics checkpoint/model name.
YOLO_MODEL_PATH=yolo11n.pt
YOLO_CONFIDENCE=0.25

# Processing limits
MAX_UPLOAD_MB=100
TILE_SIZE=512
TILE_OVERLAP=32
